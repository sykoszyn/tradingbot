# Copiar a .env en el servidor. Nunca subir .env al repo ni pegar estas claves en un chat.
# Claves de Alpaca PAPER (Alpaca → Paper Trading → API Keys). Solo permiso de trading.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Opus 5.5 para el ciclo nocturno (console.anthropic.com). Poné un tope de gasto en Limits.
ANTHROPIC_API_KEY=
# Bot de Telegram creado con @BotFather, y tu chat id (mandale /start al bot y usá `tbot telegram-id`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Contraseña del dashboard (usuario: admin).
DASHBOARD_PASSWORD=
